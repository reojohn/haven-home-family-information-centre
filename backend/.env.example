# Defaults to local SQLite database in backend/data/hic.sqlite3
# For persistent deployment, set a PostgreSQL connection URL instead.
# DATABASE_URL=postgresql://user:password@server:5432/hic
# For HTTPS hosting, set COOKIE_SECURE=1. Leave 0 only for local http:// development.
COOKIE_SECURE=0
# If frontend and backend use different origins (not recommended), comma-separated explicit frontend URLs:
# CORS_ORIGINS=https://your-hic-site.example
