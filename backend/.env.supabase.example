# Copy this file to backend/.env.supabase (never share or commit that copy).
# Supabase Dashboard > Project > Connect > Session pooler, port 5432.
# Use the exact host and username supplied by Supabase, replace [YOUR-PASSWORD],
# and percent-encode reserved characters in the database password.
# This URL belongs ONLY in FastAPI's backend config; NEVER in React/Vite.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:[YOUR-PASSWORD]@YOUR_POOLER_HOST.pooler.supabase.com:5432/postgres?sslmode=require

# Keep 0 while you are using http://127.0.0.1. Set 1 for HTTPS hosting.
COOKIE_SECURE=0
